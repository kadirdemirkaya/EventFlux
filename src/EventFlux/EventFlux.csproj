<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>EventFlux</PackageId>
		<Version>2.1.0</Version>
		<Authors>Kadir Demirkaya</Authors>
		<Copyright>Copyright (c) 2025-2026 Kadir Demirkaya</Copyright>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Description>In-process mediator for .NET with ambient DI scope by default, CanHandle handler preconditions, [HandlerOrder] ordering and a path to distributed messaging via EventFlux.RabbitFlow and EventFlux.RedisFlow. Lightweight in-process CQRS library with send/publish, pipeline behaviors, built-in logging and timeout, and deferred batch dispatch.</Description>
		<PackageProjectUrl>https://github.com/kadirdemirkaya/EventFlux</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kadirdemirkaya/EventFlux</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>CQRS EventBus mediator request-response in-memory pipeline publish-subscribe dotnet messaging</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<AssemblyInformationalVersion>2.1.0</AssemblyInformationalVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			v2.1.0:
			- Added IEventRequest&lt;Unit&gt; and the built-in Unit response type for fire-and-forget commands
			- Added AddEventOpenBehavior and AddEventBehavior helpers to register pipeline behaviors with registration-time validation
			- Added EventFluxOptions.Timeout to configure the built-in timeout behavior's time limit (previously fixed at 30 seconds)
			- Added AddEventBus&lt;TMarker&gt;() overloads that scan the assembly declaring TMarker
			- Added EventFluxOptions.RequeueStackOnCancellation (opt-in) to requeue undrained stack events on cancellation
			- AddEventBus is now safe to call more than once; discovered handlers are merged instead of re-registering shared services
			- PublishAsync with PublishStrategy.Parallel now aggregates every failing handler's exception into a single AggregateException
			- Deprecated: the EventBus constructors accepting unused assemblies/dictionaryService/eventDictionaryMapService/handlers parameters are now [Obsolete]; resolve IEventBus from DI after AddEventBus() instead. Building with TreatWarningsAsErrors turns direct calls into a build error (CS0618)
			- Aligned the net8.0 target's Microsoft.Extensions.* dependencies to 8.x instead of 9.0.0; a net8 app relying on the 9.x abstractions transitively through EventFlux now resolves 8.x and should reference them directly if 9.x is needed
			- Fixed SendAsync/PublishAsync to throw ArgumentNullException for a null request instead of failing later inside dispatch
			- Performance: added single-handler and synchronous-completion fast paths to PublishAsync; EventDispatcher skips building its pipeline delegate chain when no behaviors are registered
		</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="..\..\assets\icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.20" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	</ItemGroup>

</Project>
