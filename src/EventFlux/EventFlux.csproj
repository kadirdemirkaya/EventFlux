<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>EventFlux</PackageId>
		<Version>2.0.0</Version>
		<Authors>Kadir Demirkaya</Authors>
		<Copyright>Copyright (c) 2025-2026 Kadir Demirkaya</Copyright>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Description>In-process mediator for .NET with ambient DI scope by default, CanHandle handler preconditions, [HandlerOrder] ordering and a path to distributed messaging via EventFlux.RabbitFlow and EventFlux.RedisFlow. Lightweight MediatR alternative with send/publish, pipeline behaviors, built-in logging and timeout, and deferred batch dispatch.</Description>
		<PackageProjectUrl>https://github.com/kadirdemirkaya/EventFlux</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kadirdemirkaya/EventFlux</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>CQRS EventBus mediator mediatr-alternative in-memory pipeline publish-subscribe dotnet messaging</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<AssemblyInformationalVersion>2.0.0</AssemblyInformationalVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			v2.0.0 — Breaking Changes and Modernization:
			- BREAKING: Dropped net6.0 and net7.0 target frameworks; now targeting net8.0, net9.0, and net10.0
			- BREAKING: IEventHandler.Handle now requires CancellationToken as mandatory parameter (no longer optional overload)
			- BREAKING: EventMapService moved from EventFlux namespace to EventFlux.Services namespace
			- BREAKING: CreateScopePerEvent default changed from true to false (ambient scope by default)
			- Modernized TimeoutBehavior to use WaitAsync for reliable cancellation on all supported TFMs
			- Distinguished caller cancellation from timeout in TimeoutBehavior (no longer logs false timeout warnings)
			- Hot-path LINQ and allocation optimizations (Span-based, array-backed, allocation-free dispatch)
			- Eliminated all nullable warnings and fixed NullReferenceException in parameterless EventService/EventMapService constructors
		</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="..\..\assets\icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.20" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	</ItemGroup>

</Project>
