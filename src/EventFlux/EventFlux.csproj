<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>EventFlux</PackageId>
		<Version>1.5.0</Version>
		<Authors>Kadir Demirkaya</Authors>
		<Copyright>Copyright (c) 2025 Kadir Demirkaya</Copyright>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Description>A lightweight event-based CQRS implementation for .NET applications.</Description>
		<PackageProjectUrl>https://github.com/kadirdemirkaya/EventFlux</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kadirdemirkaya/EventFlux</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>CQRS EventBus EventSourcing .NET</PackageTags>
		<AssemblyInformationalVersion>1.5.0</AssemblyInformationalVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			v1.5.0:
			- Added EventFluxOptions configuration for ambient scope (CreateScopePerEvent = false)
			- Added PublishStrategy option (Parallel and Sequential execution)
			- Added CancellationToken overload on IEventHandler via default interface methods
			- Registered EventStackService as DI singleton for cross-scope deferred batch dispatch
			- Added HandlerLifetime option (Transient, Scoped, Singleton) and cleaned up concrete DI registrations
			- Hardened EventService and EventMapService with type-safe lookups and C# record support
			- Added duplicate request handler detection guard during AddEventBus registration
			- Aligned CanHandle behavior across SendAsync and updated nullable return contract to Task&lt;TResponse?&gt;
		</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

</Project>
